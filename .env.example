# Every setting of §8.1, with a neutral default. Copy to .env and fill in your own values.
# A value is literal, or a pointer admin-manual:<path>#<KEY> into ADMIN_MANUAL_PATH. Inline comments are not supported.
# Generated variables (G) are overwritten by the build. Real values go in .env, which git ignores.

# [B] [O] Checkout path for pointers
ADMIN_MANUAL_PATH=
# [C S B] [R] Product name, replaces every frozen "Natally" as shown text
VITE_APP_NAME=Example Astrologer
# [C B] [R] Android and desktop identifier
VITE_APP_ID=com.example.astrologer
# [C] [R] Footer, About, Terms
VITE_LEGAL_ENTITY=Example Publisher
# [C] [R] Contact
VITE_SUPPORT_EMAIL=support@example.com
# [C B] [G] Stamped by scripts/stamp-version.mjs
VITE_APP_VERSION=3.0.00000
# [C B] [G] web, android, desktop; set per build step
VITE_BUILD_TARGET=web
# [B] [R] Ordered domains: type surge or netlify; https states whether that domain really serves TLS
WEB_DEPLOY_TARGETS=[{"domain":"example-astrologer.surge.sh","type":"surge","https":true}]
# [C B] [G] First target with https: true
VITE_WEB_CANONICAL_ORIGIN=
# [C B] [G] All target domains, comma-joined
VITE_WEB_DOMAINS=
# [C B] [R] Server base
VITE_API_BASE_URL=http://localhost:41873
# [C] [O] release.json location, for the desktop update notice
VITE_RELEASE_INFO_URL=
# [C B] [O] Vite dev port
VITE_DEV_PORT=37419
# [S] [O] Node adapter port
SERVER_PORT=41873
# [S] [D] CORS list
API_ALLOWED_ORIGINS=http://localhost:37419,https://example-astrologer.surge.sh,tauri://localhost,https://tauri.localhost
# [C] [R] Firebase web config
VITE_FIREBASE_API_KEY=example-key
# [C] [R] Firebase web config
VITE_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
# [C B] [R] Firebase web config
VITE_FIREBASE_PROJECT_ID=example-project
# [C] [R] Firebase web config
VITE_FIREBASE_APP_ID=1:0:web:0
# [C] [R] Firebase web config
VITE_FIREBASE_MESSAGING_SENDER_ID=0
# [C] [D] Web OAuth client for Android Credential Manager
VITE_GOOGLE_WEB_CLIENT_ID=
# [S] [D] Admin SDK
FIREBASE_ADMIN_PROJECT_ID=
# [S] [D] Admin SDK
FIREBASE_ADMIN_CLIENT_EMAIL=
# [S] [D] Admin SDK; literal \n allowed
FIREBASE_ADMIN_PRIVATE_KEY=
# [B] [O] Service-account JSON path for rules and authorized domains; absent means soft failure
FIREBASE_DEPLOY_SA_FILE=
# [C] [D] RevenueCat Web Billing public key
VITE_RC_WEB_API_KEY=
# [C] [D] RevenueCat Play public key
VITE_RC_ANDROID_API_KEY=
# [C] [D] Offering id for credit packs; "current" is never used
VITE_RC_OFFERING_CREDITS=example-credits
# [C] [D] Offering id for the souvenir
VITE_RC_OFFERING_SOUVENIR=example-souvenir
# [C S] [D] Provider product id → credits, all rails, old products included
VITE_PRODUCT_CREDITS_JSON={"credits_small":200,"credits_medium":400,"credits_large":1000,"souvenir":0}
# [C] [D] Ids behind topup-pack-5, -10, -25 in order
VITE_PRODUCT_TOPUP_SLOTS=credits_small,credits_medium,credits_large
# [C S] [D] Souvenir product ids, comma-joined
VITE_PRODUCT_SOUVENIR_IDS=souvenir
# [C S] [O] Provider product id → entitlement key, for later modalities
VITE_PRODUCT_ENTITLEMENTS_JSON={}
# [C S] [R] USD per credit
VITE_CREDIT_USD_VALUE=0.025
# [C S] [R] Below this, no key and no reading
VITE_READING_MIN_MILLI=1000
# [C] [R] Refresh key below this
VITE_KEY_LOW_LIMIT_USD=0.01
# [S] [D] Secret API key
REVENUECAT_SECRET_KEY=
# [S] [D] Our webhook's Authorization value; also salts souvenir tokens
REVENUECAT_WEBHOOK_AUTH=
# [S] [O] Credit sandbox purchases
REVENUECAT_ALLOW_SANDBOX=false
# [C] [R] Ordered models; next on failure
VITE_OPENROUTER_MODELS=openrouter/auto
# [C] [R] Per reading
VITE_OPENROUTER_MAX_TOKENS=900
# [C] [R] Readings
VITE_OPENROUTER_TEMPERATURE=0.8
# [C] [O] HTTP-Referer; X-Title is the app name
VITE_OPENROUTER_REFERER=
# [S] [D] Mints keys
OPENROUTER_MANAGEMENT_KEY=
# [S] [D] Server key for keepsake elements
OPENROUTER_SOUVENIR_KEY=
# [S] [D] Keepsake model
OPENROUTER_SOUVENIR_MODEL=openrouter/auto
# [S] [R] Key expiry
OPENROUTER_KEY_TTL_SECONDS=3600
# [S] [R] Keep a retired key for late usage
OPENROUTER_RETIRE_GRACE_SECONDS=600
# [C] [R] Download base
VITE_VOICE_BASE_URL=https://huggingface.co
# [C] [R] Model repo
VITE_VOICE_REPO=onnx-community/Supertonic-TTS-ONNX
# [C] [R] Revision; the owner's .env pins a commit
VITE_VOICE_REVISION=main
# [C] [R] voices/<id>.bin
VITE_VOICE_ID=F4
# [C S] [O] Empty disables analytics
VITE_GA_MEASUREMENT_ID=
# [S] [O] Measurement Protocol
GA_API_SECRET=
# [S B] [D] Delivery host; packages too
SFTP_HOST=
# [S B] [D] Delivery host port
SFTP_PORT=22
# [S B] [D] Delivery host login
SFTP_USER=
# [S B] [D] Delivery host password
SFTP_PASSWORD=
# [S] [D] Remote souvenir root
SFTP_BASE_PATH=
# [S] [D] Public URL of that root
SFTP_PUBLIC_BASE_URL=
# [B] [O] Remote packages directory; empty skips
RELEASE_SFTP_PATH=
# [S] [D] Mail
SMTP_HOST=
# [S] [D] Mail port
SMTP_PORT=587
# [S] [D] Mail uses TLS from the start
SMTP_SECURE=false
# [S] [D] Mail login
SMTP_USER=
# [S] [D] Mail password
SMTP_PASSWORD=
# [S] [D] Mail sender
SMTP_FROM=Example Astrologer <hello@example.com>
# [C] [O] Button landing-install-play; hidden if empty
VITE_LINK_PLAY=
# [C] [O] Windows package URL; hidden if empty
VITE_LINK_WINDOWS=
# [C] [O] Linux package URL; hidden if empty
VITE_LINK_LINUX=
# [C] [O] Terms target
VITE_LINK_TERMS=/legal/terms
# [C] [O] Privacy target
VITE_LINK_PRIVACY=/legal/privacy
# [C] [O] Contact target
VITE_LINK_CONTACT=mailto:support@example.com
# [B] [D] Surge account
SURGE_LOGIN=
# [B] [D] Surge token
SURGE_TOKEN=
# [B] [O] CLI deploy; absent prints an action and continues
NETLIFY_AUTH_TOKEN=
# [B] [O] Functions site, and netlify-type web targets
NETLIFY_SITE_ID=
# [B] [O] Signing; absent builds an unsigned AAB and says so
ANDROID_KEYSTORE_PATH=
# [B] [O] Android keystore password
ANDROID_KEYSTORE_PASSWORD=
# [B] [O] Android key alias
ANDROID_KEY_ALIAS=
# [B] [O] Android key password
ANDROID_KEY_PASSWORD=
